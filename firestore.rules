rules_version = '2';
// Padel Tour – Firestore security rules.
// To apply: Firebase console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIn(data, roles) {
      return signedIn() && data.members.get(request.auth.uid, '') in roles;
    }
    function tRole(tid, roles) {
      return roleIn(get(/databases/$(database)/documents/tournaments/$(tid)).data, roles);
    }

    // Marketplace: anyone can read, signed-in users post and manage their own listings,
    // the site admin (by verified email) can remove any listing and delete any tournament.
    function isSiteAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['minamorise@gmail.com'];
    }
    function validListing(d) {
      return d.keys().hasOnly(['category','title','description','price','location','phone','ownerUid','createdAt','updatedAt'])
        && d.category in ['partner','gear','coach','gift']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 1000
        && d.price is string && d.price.size() <= 40
        && d.location is string && d.location.size() <= 60
        && d.phone is string && d.phone.matches('^[0-9]{7,15}$');
    }
    match /listings/{lid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && validListing(request.resource.data);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid && validListing(request.resource.data);
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isSiteAdmin());
    }

    // Reports on marketplace listings: anyone signed in can report; only the site admin reads and clears them
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listingId','reason','reporterUid','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.listingId is string && request.resource.data.listingId.size() <= 64
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300;
      allow read, delete: if isSiteAdmin();
    }

    // Player profiles: the owner writes; everyone reads public ones, only the owner reads a private one.
    function validProfile(d) {
      return d.keys().hasOnly(['displayName','photoURL','city','homeClub','level','levelHistory','hand','side','matchType','days','times','whatsapp','about','visibility','createdAt','updatedAt'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && d.visibility in ['public','private']
        && (d.level == null || (d.level is number && d.level >= 0 && d.level <= 7))
        && d.levelHistory is list && d.levelHistory.size() <= 100
        && d.whatsapp is string && (d.whatsapp == '' || d.whatsapp.matches('^[0-9]{7,15}$'))
        && d.about is string && d.about.size() <= 300;
    }
    match /profiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || resource.data.visibility == 'public';
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /tournaments/{tid} {
      // Anyone can follow results (viewers don't need an account)
      allow read: if true;

      // Any signed-in user can create a tournament and becomes its admin
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'admin'
        && request.resource.data.memberUids == [request.auth.uid];

      // Admins can change everything (but the owner always stays admin).
      // Editors can only change scores.
      allow update: if (roleIn(resource.data, ['admin'])
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.members.get(resource.data.ownerUid, '') == 'admin')
        || (roleIn(resource.data, ['editor'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores', 'updatedAt']));

      // The creator, or the site admin, can delete it
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isSiteAdmin());

      // Registrations (one per signed-in person, stored under their uid): see js/register.js.
      // The registrant creates and cancels their own; the partner from an invite link (who must know
      // the secret code) can put their account on it once; tournament admins manage everything.
      match /entries/{uid} {
        function validEntry(d) {
          return d.keys().hasOnly(['kind','name','me','partner','phone','status','code','createdAt','updatedAt'])
            && d.kind in ['team','player']
            && d.name is string && d.name.size() > 0 && d.name.size() <= 40
            && d.me is map && d.me.uid == uid && d.me.name is string && d.me.name.size() > 0 && d.me.name.size() <= 40
            && (d.partner == null || (d.partner is map && !d.partner.keys().hasAny(['uid'])
                && d.partner.name is string && d.partner.name.size() > 0 && d.partner.name.size() <= 40))
            && d.phone is string && (d.phone == '' || d.phone.matches('^[0-9]{7,15}$'))
            && d.code is string && d.code.size() >= 8 && d.code.size() <= 32
            && d.status in ['pending','waitlist'];
        }
        allow read: if (signedIn() && request.auth.uid == uid) || tRole(tid, ['admin'])
          || (signedIn() && resource.data.partner != null && resource.data.partner.get('uid', '') == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('regOpen', false) == true
          && validEntry(request.resource.data);
        allow update: if tRole(tid, ['admin'])
          || (signedIn() && request.auth.uid != uid && resource.data.kind == 'team'
              && resource.data.partner != null && !resource.data.partner.keys().hasAny(['uid'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partner','updatedAt'])
              && request.resource.data.partner.keys().hasOnly(['uid','name','photoURL','code'])
              && request.resource.data.partner.uid == request.auth.uid
              && request.resource.data.partner.code == resource.data.code
              && request.resource.data.partner.name is string
              && request.resource.data.partner.name.size() > 0 && request.resource.data.partner.name.size() <= 40);
        allow delete: if tRole(tid, ['admin'])
          || (signedIn() && request.auth.uid == uid && resource.data.status in ['pending','waitlist','declined']);
      }

      // Edit-access requests: you manage your own, admins manage all
      match /requests/{uid} {
        allow read, delete: if (signedIn() && request.auth.uid == uid) || tRole(tid, ['admin']);
        allow create, update: if (signedIn() && request.auth.uid == uid
                                  && request.resource.data.status == 'pending')
                              || tRole(tid, ['admin']);
      }
    }
  }
}
